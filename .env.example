# =============================================================================
# PCB-RAG 环境变量模板
#
# 模型后端支持两种模式，通过 *_BACKEND 切换：
#   local = 本地服务（Ollama / HuggingFace）
#   api   = OpenAI 兼容 HTTP 接口（DeepSeek / 通义百炼 / 硅基流动 / OpenAI / vLLM ...）
#
# 默认 local 保持向后兼容；如需调用远端 API，把对应 *_BACKEND 改为 api 并填写下方配置。
# =============================================================================

# ------------------------------ Paths ---------------------------------------
DATA_DIR=./data/clear_docs
LEXICAL_CACHE_PATH=./data/lexical_corpus.jsonl
# 词法缓存有效期（小时），超过后自动重建；入库完成时也会自动清理
LEXICAL_CACHE_TTL_HOURS=24
# 入库结束时写入的重载标记（内容为时间戳）。长驻 API 轮询其 mtime 变化后会
# 在后台重建 BM25 —— 否则删缓存文件对已启动的进程无效，新文档会缺一整路投票。
# LEXICAL_RELOAD_STAMP=./data/lexical_corpus.jsonl.stamp

# ------------------------------ Milvus --------------------------------------
MILVUS_URI=http://127.0.0.1:19530
COLLECTION=pcb_kb
MILVUS_EMBEDDING_FIELD=embedding
# 入库时是否重建集合（1=清空重建，0=增量 upsert，默认 0）
# 注意：重建时会忽略并重写入库清单（清单里的指纹在集合被清空后已全部失效），
# 否则会出现「库被清空但清单说数据都在」→ 之后每次增量入库都空转。
INGEST_OVERWRITE=0
# 增量入库：只处理新增 / 变更的文档，并清理已删除文档的残留 chunk
INGEST_INCREMENTAL=1
INGEST_MANIFEST_PATH=./data/ingest_manifest.json

# ============================ 模型后端选择 ===================================
LLM_BACKEND=local
EMBED_BACKEND=local

# ---------------------- LLM: local（Ollama 本地服务） ------------------------
OLLAMA_BASE=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=qwen3.5:35b-a3b-q4_K_M
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=300

# ---------------------- LLM: api（OpenAI 兼容接口） --------------------------
# 示例：
#   硅基流动   LLM_BASE_URL=https://api.siliconflow.cn/v1
#   DeepSeek   LLM_BASE_URL=https://api.deepseek.com/v1
#   通义百炼   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   OpenAI     LLM_BASE_URL=https://api.openai.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=180
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7
LLM_CONTEXT_WINDOW=8192

# ------------------- Embedding: local（Ollama 本地服务） ---------------------
OLLAMA_EMBED_MODEL=qwen3-embedding:8b-q8_0
EMBED_NUM_CTX=2048

# ------------------- Embedding: api（OpenAI 兼容 /embeddings） ---------------
# EMBED_BASE_URL / EMBED_API_KEY 留空时自动复用 LLM_BASE_URL / LLM_API_KEY
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
# 向量维度：留空则自动探测一次；Milvus 建表需要，建议显式填写（如 1024）
EMBED_DIM=
EMBED_BATCH_SIZE=16

# ------------------------------ Rerank --------------------------------------
# api           = HTTP /rerank 接口（推荐，无需本地显存）
# hf            = 本地 HuggingFace cross-encoder
# qwen3reranker = 本地 Qwen3-Reranker 生成式模型
# sbert         = 本地 SentenceTransformer cross-encoder
# none          = 关闭精排
RERANK_ENABLED=1
RERANK_BACKEND=api
RERANK_TOP_N=10
# 示例（Jina）：https://api.jina.ai/v1/rerank
# 示例（硅基流动）：https://api.siliconflow.cn/v1/rerank
RERANK_API_URL=
RERANK_API_KEY=
RERANK_API_MODEL=
RERANK_API_TIMEOUT=60

# 本地 Rerank 参数（RERANK_BACKEND=hf/qwen3reranker/sbert 时生效）
RERANK_MODEL=Qwen/Qwen3-Reranker-4B
HF_RERANK_MODEL=Qwen/Qwen3-Reranker-4B
HF_RERANK_MAX_LENGTH=1024
HF_RERANK_BATCH_SIZE=16
HF_RERANK_DEVICE=auto
HF_RERANK_DTYPE=auto
RERANK_GPU_ID=auto
HF_ENDPOINT=https://hf-mirror.com

# ------------------ 召回评测（eval/evaluate_recall.py） -----------------------
# 软匹配判定用的大模型（可选）。全部留空时自动复用当前 LLM 后端：
#   LLM_BACKEND=api → 用 LLM_BASE_URL / LLM_MODEL / LLM_API_KEY
# 因此「无显卡、只有模型 API」的服务器无需任何额外配置即可跑软匹配。
# 想让「另一个厂商的模型当判卷人」（消除同源评测偏差）时，单独设置下面几项：
# SOFT_JUDGE_BACKEND=openai          # auto / ollama / openai（auto=按 base_url 猜测）
# SOFT_JUDGE_BASE_URL=https://api.deepseek.com/v1
# SOFT_JUDGE_MODEL=deepseek-chat
# SOFT_JUDGE_API_KEY=sk-xxxx
# SOFT_JUDGE_TIMEOUT=60
# 评测开关（也可用命令行参数覆盖，命令行优先）
# SOFT_MATCH=embed                   # none / llm / embed
# EMBED_MATCH_THRESHOLD=0.78         # 软匹配的 embedding 相似度阈值
# EVAL_LLM_MODEL=                    # 覆盖评测用 LLM 模型名；留空用 LLM_MODEL（勿填 Ollama 模型名）
# SOFT_MATCH_CACHE=./eval/softmatch_cache.jsonl

# --------------------------- Document chunking ------------------------------
NODE_PARSER_MODE=parent_child
PARENT_MAX_SIZE=3000
PARENT_MIN_SIZE=200
PARENT_MIN_SECTION_KEEP=120
CHILD_MAX_SIZE=800
CHILD_MIN_SIZE=150
CHILD_OVERLAP=80
SEMANTIC_SPLIT_THRESHOLD=1600
SEMANTIC_VARIANCE_THRESHOLD=0.15

# ------------------------------ Retrieval -----------------------------------
LEXICAL_ENABLED=1
LEXICAL_MAX_BYTES=8000
RECALL_TOP_K=200
FUSION_MODE=RECIPROCAL_RANK
FUSION_WEIGHTS=0.45,0.55
FUSION_NUM_QUERIES=4
QUERY_EXPANSION_ENABLED=1
MULTI_EXPAND_ENABLED=1
HYDE_ENABLED=1
QUERY_ROUTING_ENABLED=1
CHUNK_EXPAND_ENABLED=1
CHUNK_EXPAND_NEIGHBORS=1
CHUNK_EXPAND_PARENT=1
CHUNK_GROUP_BY_DOC=1
# 扩展上下文可额外返回的最大条数（不占用 top_k 配额）
CHUNK_EXPAND_MAX_EXTRA=5

# -------------------- 查询理解（意图识别 / 分解 / Step-back） ----------------
# rule = 纯规则；llm = 始终调 LLM；hybrid = 规则落到 general 时才调 LLM
QUERY_UNDERSTANDING_MODE=hybrid
# 复合问题自动拆分为子问题（多跳问题召回更全）
QUERY_DECOMPOSE_ENABLED=1
DECOMPOSE_MAX_SUB_QUERIES=3
# 过于具体的问题（含标准号 / 条款号）自动生成上位问题补充背景知识
QUERY_STEP_BACK_ENABLED=1
# Step-back 召回路线在 RRF 融合中的权重系数（相对原始向量权重）
STEPBACK_ROUTE_WEIGHT=0.7

# ------------------ Contextual Retrieval（chunk 语境前缀） ------------------
# off  = 关闭
# rule = 规则版：文档名 + 标题路径 + 标准号（零 LLM 成本，推荐）
# llm  = LLM 版：模型生成语境说明（效果更好，入库时每个 chunk 一次调用）
CONTEXTUAL_RETRIEVAL_MODE=rule
CONTEXTUAL_LLM_WORKERS=4
CONTEXTUAL_LLM_MAX_CHARS=120
CONTEXTUAL_LLM_BATCH=1000

# --------------------------- Answer generation ------------------------------
CITATION_ENABLED=1
RAG_TOP_DOCS=5
RAG_DOC_MAX_CHARS=1000
# Agentic RAG（迭代检索）：开启后进入「检索 → 充分性判断 → 不足则改写重检」循环收集资料
SELF_RAG_ENABLED=0
SELF_RAG_MAX_ITERATIONS=3

# ------------------------------ 缓存 ----------------------------------------
# 语义缓存：相同或语义相近的查询直接复用检索 / 答案结果
SEMANTIC_CACHE_ENABLED=1
SEMANTIC_CACHE_MAX_SIZE=512
SEMANTIC_CACHE_TTL_SECONDS=3600
# 语义命中的相似度阈值（越高越保守）
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_MAX_PROBE=256

# ------------------------------ Dify API ------------------------------------
# 必填。未设置或仍为 change-me 时服务**拒绝启动**（占位值等于无鉴权）。
# 生成方式示例：python -c "import secrets;print(secrets.token_urlsafe(32))"
DIFY_API_TOKEN=
API_PORT=8000
# 允许跨域的来源白名单（逗号分隔）。留空 = 不下发任何 CORS 头（推荐）。
# 仅在需要浏览器直连时才配置，例如：CORS_ALLOW_ORIGINS=https://dify.example.com
CORS_ALLOW_ORIGINS=
SESSION_EXPIRE_MINUTES=60
SESSION_MAX_COUNT=1000
# 会话持久化：memory（默认，进程重启后丢失）| sqlite（落盘，重启后保留）
SESSION_STORE=memory
SESSION_DB_PATH=./data/sessions.db

# =============================================================================
# P1-2  GraphRAG：实体关系图检索（多跳 / 聚合类问题）
# =============================================================================
# 开启后：入库时抽取三元组建图，检索时把图路径与向量/词法结果融合
# 图谱文件缺失时自动降级为无图检索，不影响主链路
GRAPH_RAG_ENABLED=0
GRAPH_PATH=./data/graph/kg.json
# rule   = 句式规则 + 实体共现（零 LLM 成本，建议起步用这个）
# llm    = 模型抽取（关系更准，入库时每个 chunk 一次调用）
# hybrid = 规则 + 模型双路合并
GRAPH_EXTRACT_BACKEND=rule
GRAPH_LLM_WORKERS=4
GRAPH_LLM_MAX_CHARS=1600
GRAPH_MAX_TRIPLES_PER_CHUNK=12
# ---- 图检索 ----
GRAPH_HOP=1
GRAPH_TOP_K=5
# 图路作为独立一路参与 RRF 融合的权重（量纲无关）
GRAPH_WEIGHT=0.35
# 图路的 RRF 平滑参数 k
GRAPH_RRF_K=60
# 图证据在最终结果中的独立配额，避免凭规则分挤占主结果的 top-k 名额
# （与上面的 GRAPH_EXPAND_MAX 不同：那个管「图扩展生成几条」，这个管「最终保留几条」）
GRAPH_EVIDENCE_MAX=2
GRAPH_MAX_ENTITIES_PER_QUERY=8
GRAPH_MAX_NEIGHBORS=24
# 图邻域扩展追加的额外事实条数
GRAPH_EXPAND_MAX=2
# ---- 社区检测与摘要（面向「综述类」问题）----
GRAPH_COMMUNITY_ENABLED=0
GRAPH_COMMUNITY_MIN_SIZE=3
GRAPH_COMMUNITY_MAX_SUMMARY_CHARS=600

# =============================================================================
# P2  上下文压缩与去重
# =============================================================================
# 召回链路较长（向量 + BM25 + HyDE + Chunk 扩展 + 父块回填）时建议开启
CONTEXT_COMPRESSION_ENABLED=0
# extractive = 抽取式（零 LLM 成本，推荐）；llm = 模型压缩；hybrid = 先抽取再模型
COMPRESSION_MODE=extractive
COMPRESSION_TARGET_RATIO=0.6
COMPRESSION_MIN_CHARS=160
COMPRESSION_MAX_CHARS=900
# 进入上下文的字符预算，超出后按相关性截断尾部
COMPRESSION_BUDGET_CHARS=12000
COMPRESSION_MIN_SENTENCE_LEN=6
COMPRESSION_MAX_SENTENCE_LEN=400
# 近似去重：父块回填与邻居扩展容易带进重复内容
CONTEXT_DEDUPE_ENABLED=1
CONTEXT_DEDUPE_THRESHOLD=0.85
CONTEXT_DEDUPE_MIN_CHARS=80

# =============================================================================
# P2  访问控制（多租户 / 角色 / 组）
# =============================================================================
# 开启后：入库写入租户字段，检索按「同租户 OR 公开 OR 组命中」过滤，并支持审计
ACL_ENABLED=0
ACL_TENANT_FIELD=tenant_id
ACL_GROUPS_FIELD=acl_groups
ACL_VISIBILITY_FIELD=visibility
ACL_OWNER_FIELD=owner_id
# visibility 等于该值的文档对所有租户可见
ACL_PUBLIC_VALUE=public
# 入库默认可视性：private 更安全；整库单租户部署可设为 public
ACL_DEFAULT_VISIBILITY=private
# 入库写入的默认租户（留空则用 ACL_ANONYMOUS_TENANT）
ACL_DEFAULT_TENANT=
# 未携带身份信息时的兜底租户
ACL_ANONYMOUS_TENANT=public
# 可跨租户访问的角色
ACL_ADMIN_ROLES=admin,root
# 是否信任客户端传入的身份头。
# 默认 0（关闭）：打开 ACL 后若同时信任自报头，任何调用方只要自报
# `X-User-Roles: admin` 就能读全库（build_acl_filters 对 admin 返回 None = 全放行）。
# 仅当身份由网关注入、且网关已剥离客户端同名头时才开启。
ACL_TRUST_HEADERS=0
# 显式确认「网关已剥离客户端自报头」。ACL_ENABLED=1 且 ACL_TRUST_HEADERS=1
# 而未设置本项时，服务**拒绝启动**（把最常见的静默全开变成一次响亮的失败）。
ACL_TRUST_HEADERS_ACK=0
# 未标注任何权限字段的历史数据：1 = 拒绝访问（严格模式）
ACL_STRICT_LEGACY=0
# 身份请求头（Dify 工作流 / 网关注入）
ACL_HEADER_USER=X-User-Id
ACL_HEADER_TENANT=X-Tenant-Id
ACL_HEADER_ROLES=X-User-Roles
ACL_HEADER_GROUPS=X-User-Groups
# 访问审计日志
ACL_AUDIT_ENABLED=1
ACL_AUDIT_PATH=./data/acl_audit.jsonl

# =============================================================================
# P2  可观测性（tracing / 指标 / 事件）
# =============================================================================
OBSERVABILITY_ENABLED=1
TRACE_ENABLED=1
METRICS_ENABLED=1
TRACE_LOG_PATH=./data/traces.jsonl
# 采样率：1.0 = 全量记录；高 QPS 场景可降到 0.1 降低开销
TRACE_SAMPLE_RATE=1.0
# 慢 span 阈值（毫秒），超过则在日志中标记 slow=true
SLOW_SPAN_MS=3000
TRACE_MAX_ATTR_LEN=600
METRIC_WINDOW=2048
TRACE_FLUSH_EVERY=32
TRACE_FLUSH_INTERVAL=5

# =============================================================================
# P2  多模态（PDF 图片描述 + 表格结构化）
# =============================================================================
# 图片描述需视觉模型（VLM）：开启后入库变慢（每张图一次调用）
MULTIMODAL_ENABLED=0
# base_url / api_key 留空时自动复用 LLM_BASE_URL / LLM_API_KEY
# 示例：MULTIMODAL_VLM_MODEL=qwen-vl-max / gpt-4o-mini / glm-4v
MULTIMODAL_VLM_BASE_URL=
MULTIMODAL_VLM_API_KEY=
MULTIMODAL_VLM_MODEL=
MULTIMODAL_VLM_TIMEOUT=120
MULTIMODAL_MAX_TOKENS=512
MULTIMODAL_MAX_IMAGES_PER_DOC=20
# 过滤装饰性小图，避免浪费 VLM 调用
MULTIMODAL_MIN_IMAGE_PX=120
MULTIMODAL_MIN_IMAGE_BYTES=4096
MULTIMODAL_DESC_MAX_CHARS=500
# 表格结构化成 Markdown（零成本，建议开启）
TABLE_MARKDOWN_ENABLED=1
TABLE_MIN_ROWS=2
TABLE_MIN_COLS=2
