# =============================================================================
# PCB-RAG 环境变量模板
#
# 模型后端支持两种模式，通过 *_BACKEND 切换：
#   local = 本地服务（Ollama / HuggingFace）
#   api   = OpenAI 兼容 HTTP 接口（DeepSeek / 通义百炼 / 硅基流动 / OpenAI / vLLM ...）
#
# 默认 local 保持向后兼容；如需调用远端 API，把对应 *_BACKEND 改为 api 并填写下方配置。
# =============================================================================

# ------------------------------ Paths ---------------------------------------
DATA_DIR=./data/clear_docs
LEXICAL_CACHE_PATH=./data/lexical_corpus.jsonl
# 词法缓存有效期（小时），超过后自动重建；入库完成时也会自动清理
LEXICAL_CACHE_TTL_HOURS=24

# ------------------------------ Milvus --------------------------------------
MILVUS_URI=http://127.0.0.1:19530
COLLECTION=pcb_kb
MILVUS_EMBEDDING_FIELD=embedding
# 入库时是否重建集合（1=清空重建，0=增量 upsert，默认 0）
INGEST_OVERWRITE=0

# ============================ 模型后端选择 ===================================
LLM_BACKEND=local
EMBED_BACKEND=local

# ---------------------- LLM: local（Ollama 本地服务） ------------------------
OLLAMA_BASE=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=qwen3.5:35b-a3b-q4_K_M
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=300

# ---------------------- LLM: api（OpenAI 兼容接口） --------------------------
# 示例：
#   硅基流动   LLM_BASE_URL=https://api.siliconflow.cn/v1
#   DeepSeek   LLM_BASE_URL=https://api.deepseek.com/v1
#   通义百炼   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   OpenAI     LLM_BASE_URL=https://api.openai.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=180
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7
LLM_CONTEXT_WINDOW=8192

# ------------------- Embedding: local（Ollama 本地服务） ---------------------
OLLAMA_EMBED_MODEL=qwen3-embedding:8b-q8_0
EMBED_NUM_CTX=2048

# ------------------- Embedding: api（OpenAI 兼容 /embeddings） ---------------
# EMBED_BASE_URL / EMBED_API_KEY 留空时自动复用 LLM_BASE_URL / LLM_API_KEY
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
# 向量维度：留空则自动探测一次；Milvus 建表需要，建议显式填写（如 1024）
EMBED_DIM=
EMBED_BATCH_SIZE=16

# ------------------------------ Rerank --------------------------------------
# api           = HTTP /rerank 接口（推荐，无需本地显存）
# hf            = 本地 HuggingFace cross-encoder
# qwen3reranker = 本地 Qwen3-Reranker 生成式模型
# sbert         = 本地 SentenceTransformer cross-encoder
# none          = 关闭精排
RERANK_ENABLED=1
RERANK_BACKEND=api
RERANK_TOP_N=10
# 示例（Jina）：https://api.jina.ai/v1/rerank
# 示例（硅基流动）：https://api.siliconflow.cn/v1/rerank
RERANK_API_URL=
RERANK_API_KEY=
RERANK_API_MODEL=
RERANK_API_TIMEOUT=60

# 本地 Rerank 参数（RERANK_BACKEND=hf/qwen3reranker/sbert 时生效）
RERANK_MODEL=Qwen/Qwen3-Reranker-4B
HF_RERANK_MODEL=Qwen/Qwen3-Reranker-4B
HF_RERANK_MAX_LENGTH=1024
HF_RERANK_BATCH_SIZE=16
HF_RERANK_DEVICE=auto
HF_RERANK_DTYPE=auto
RERANK_GPU_ID=auto
HF_ENDPOINT=https://hf-mirror.com

# --------------------------- Document chunking ------------------------------
NODE_PARSER_MODE=parent_child
PARENT_MAX_SIZE=3000
PARENT_MIN_SIZE=200
PARENT_MIN_SECTION_KEEP=120
CHILD_MAX_SIZE=800
CHILD_MIN_SIZE=150
CHILD_OVERLAP=80
SEMANTIC_SPLIT_THRESHOLD=1600
SEMANTIC_VARIANCE_THRESHOLD=0.15

# ------------------------------ Retrieval -----------------------------------
LEXICAL_ENABLED=1
LEXICAL_MAX_BYTES=8000
RECALL_TOP_K=200
FUSION_MODE=RECIPROCAL_RANK
FUSION_WEIGHTS=0.45,0.55
FUSION_NUM_QUERIES=4
QUERY_EXPANSION_ENABLED=1
MULTI_EXPAND_ENABLED=1
HYDE_ENABLED=1
QUERY_ROUTING_ENABLED=1
CHUNK_EXPAND_ENABLED=1
CHUNK_EXPAND_NEIGHBORS=1
CHUNK_EXPAND_PARENT=1
CHUNK_GROUP_BY_DOC=1
# 扩展上下文可额外返回的最大条数（不占用 top_k 配额）
CHUNK_EXPAND_MAX_EXTRA=5

# --------------------------- Answer generation ------------------------------
CITATION_ENABLED=1
RAG_TOP_DOCS=5
RAG_DOC_MAX_CHARS=1000
SELF_RAG_ENABLED=0

# ------------------------------ Dify API ------------------------------------
DIFY_API_TOKEN=change-me
API_PORT=8000
SESSION_EXPIRE_MINUTES=60
SESSION_MAX_COUNT=1000
